# ===== 网页总结工具 配置 =====
# 至少配置一个服务商的 API Key，对应服务商会出现在前端下拉列表中。
# 未配置 key 的服务商会自动隐藏。
#
# 说明：前端「设置」页用 localStorage 存的 Key 优先级更高（仅当前浏览器）。
#       此处 .env 是兜底 / 团队共享：前端未配置时回退读取，适合多人共用部署。

# 智谱 GLM（注册：https://bigmodel.cn/ ，新用户有免费额度）
ZHIPU_API_KEY=

# DeepSeek 官方（注册：https://platform.deepseek.com/ ）
# 直连官方、价格最低之一。模型：deepseek-chat / deepseek-reasoner
DEEPSEEK_API_KEY=

# 硅基流动 SiliconFlow（注册：https://cloud.siliconflow.cn/ ）
# 聚合 DeepSeek / Qwen / GLM / Llama 等，注册送额度，国内访问稳定
SILICONFLOW_API_KEY=

# OpenAI 官方（注册：https://platform.openai.com/ ）
# 海外原生 GPT 系列（gpt-4o / gpt-4.1 / o 系列等），需海外网络与 Key
OPENAI_API_KEY=

# 服务端口（默认 3000）
PORT=3000
