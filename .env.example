# ===== 网页总结工具 配置 =====
# 至少配置一个服务商的 API Key，对应服务商会出现在前端下拉列表中。
# 未配置 key 的服务商会自动隐藏。

# 智谱 GLM（注册：https://bigmodel.cn/ ，新用户有免费额度）
ZHIPU_API_KEY=

# 并行科技 paratera（https://llmapi.paratera.com/v1 ）
# 支持大量模型：DeepSeek-V4-Flash-0731、GLM-5.2、Qwen3.7-Max 等，详见 config/providers.js
# 注：GLM-5.2 在该平台夜间 21:00 ~ 09:00 免费
PARATERA_API_KEY=

# 服务端口（默认 3000）
PORT=3000
